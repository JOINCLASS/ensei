# ローカルの Supabase（docker）向けの値。
# `supabase start` が出力する API_URL と PUBLISHABLE_KEY と同じもの。
# ローカルの鍵は誰の環境でも同じ固定値なので、そのままコピーして使える。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 招待の引き換えにサーバー側だけで使う（NEXT_PUBLIC_ を付けないのでブラウザには出ない）。
# `supabase status` の SECRET_KEY と同じ値。
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
